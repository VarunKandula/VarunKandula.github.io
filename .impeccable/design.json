  "narrative": {
    "northStar": "A quiet personal portfolio",
    "overview": "The supplied Devin source and screenshot are the visual authority. The shipped site pairs a narrow reading column, fine section rules, understated metadata, supplied photography, and four drawn watch faces. This record describes that implementation rather than proposing a new identity.",
    "keyCharacteristics": [
      "Warm off-white and charcoal themes with restrained terracotta details.",
      "Serif identity, compact sans-serif prose, and monospaced labels and dates.",
      "Open sections and rows, with live SVG watches as the signature illustration."
    ],
    "rules": [
      {
        "name": "The Paired Theme Rule",
        "body": "Change semantic roles together; retain the same hierarchy and geometry in both themes.",
        "section": "colors"
      },
      {
        "name": "The Three Voices Rule",
        "body": "Keep identity in serif, reading text in sans, and short labels or measurements in mono.",
        "section": "typography"
      },
      {
        "name": "The Open Surface Rule",
        "body": "Preserve section rules and unboxed content as the page's structure.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the supplied typography, photography, thin rules, and watch geometry.",
      "**Do** use paired theme roles and visible keyboard focus.",
      "**Do** keep native disclosures, readable captions, and responsive row wrapping."
    ],
    "donts": [
      "**Don't** turn the open sections into a dashboard of cards.",
      "**Don't** promote the clock's green status decoration into a general action color.",
      "**Don't** treat supplied investment and watch-reference placeholders as reusable copy rules."
    ]
  }
}
