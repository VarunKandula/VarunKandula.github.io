    {
      "name": "Interest tag",
      "kind": "chip",
      "description": "Informational outlined pill; hover is visual feedback, not selection.",
      "html": "<ul class=\"ds-tags\"><li>Squash <span>played D1</span></li><li>Boxing</li></ul>",
      "css": ".ds-tags{font:400 14.5px/1.6 var(--sans,Inter,sans-serif);color:var(--fg,#1a1a19);display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0}.ds-tags li{padding:3px 10px;border:1px solid var(--line,#ebebe7);border-radius:999px;font-size:13px;transition:border-color .2s var(--ease,cubic-bezier(0.25,1,0.5,1)),background .2s var(--ease,cubic-bezier(0.25,1,0.5,1))}.ds-tags li:hover{border-color:var(--faint,#c9c9c4);background:var(--hover,#f3f3f0)}.ds-tags span{color:var(--muted,#6f6f6a)}.ds-tags span:before{content:\"\u00b7 \"}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{animation:none!important;transition:none!important}}",
      "refersTo": "tag"
    },
    {
      "name": "Experience disclosure",
      "kind": "custom",
      "description": "Native details row with aligned dates and a muted expansion.",
      "html": "<details class=\"ds-row\"><summary><span class=\"ds-main\"><span class=\"ds-title\">Kinect</span><span class=\"ds-sub\">Co-founder &amp; CTO</span></span><span class=\"ds-meta\">2026\u2013</span></summary><p>AI sales reps, dynamic product and landing pages, and generative storefronts for Shopify brands. YC P26.</p></details>",
      "css": ".ds-row{font:400 14.5px/1.6 var(--sans,Inter,sans-serif);color:var(--fg,#1a1a19);}.ds-row summary{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:6px 10px;margin:0 -10px;cursor:pointer;list-style:none;border-radius:8px;transition:background .2s var(--ease,cubic-bezier(0.25,1,0.5,1))}.ds-row summary::-webkit-details-marker{display:none}.ds-row summary:hover{background:var(--hover,#f3f3f0)}.ds-row summary:focus-visible{outline:1.5px solid var(--accent,#b5552e);outline-offset:3px;border-radius:3px;}.ds-main{display:flex;gap:10px;align-items:baseline;min-width:0;flex-wrap:wrap}.ds-title{font-weight:500;white-space:nowrap}.ds-sub,.ds-meta{color:var(--muted,#6f6f6a)}.ds-meta{font-family:var(--mono,\"JetBrains Mono\",monospace);font-size:11.5px;letter-spacing:0;font-variant-numeric:tabular-nums;white-space:nowrap;flex:none}.ds-row[open] .ds-sub{color:var(--fg,#1a1a19)}.ds-row>p{margin:0;padding:2px 0 12px;color:var(--muted,#6f6f6a);max-width:46ch;animation:ds-drop .35s var(--ease,cubic-bezier(0.25,1,0.5,1))}@keyframes ds-drop{from{transform:translateY(-4px)}to{transform:none}}@media(max-width:640px){.ds-main{flex-direction:column;gap:0}.ds-title{white-space:normal}}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{animation:none!important;transition:none!important}}",
      "refersTo": "experience-summary"
    },
