      "css": ".ds-close{font:400 14.5px/1.6 var(--sans,Inter,sans-serif);color:var(--fg,#1a1a19);width:44px;height:44px;padding:0;display:inline-grid;place-items:center;border:1px solid var(--line,#ebebe7);border-radius:50%;background:var(--bg,#fbfbfa);cursor:pointer}.ds-close:hover{background:var(--hover,#f3f3f0)}.ds-close:focus-visible{outline:1.5px solid var(--accent,#b5552e);outline-offset:3px;border-radius:3px;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{animation:none!important;transition:none!important}}",
