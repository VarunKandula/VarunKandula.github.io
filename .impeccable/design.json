      "css": ".ds-static{font:400 14.5px/1.6 var(--sans,Inter,sans-serif);color:var(--fg,#1a1a19);display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:6px 10px;margin:0 -10px;border-radius:8px}.ds-project{display:flex;flex-direction:column;min-width:0}.ds-project-title{font-weight:500}.ds-project-sub,.ds-project-meta{color:var(--muted,#6f6f6a)}.ds-project-meta{font-family:var(--mono,\"JetBrains Mono\",monospace);font-size:11.5px;letter-spacing:0;font-variant-numeric:tabular-nums;white-space:nowrap;flex:none}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{animation:none!important;transition:none!important}}"
