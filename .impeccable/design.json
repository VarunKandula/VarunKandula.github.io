    {
      "name": "Theme toggle",
      "kind": "button",
      "description": "Circular next-theme control; this preview shows the moon state. Runtime supplies switching, persistence, and action labels.",
      "html": "<button class=\"ds-toggle\" type=\"button\" aria-label=\"Switch to dark mode\"><svg class=\"ds-moon\" viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n              <path d=\"M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z\" />\n            </svg></button>",
      "css": ".ds-toggle{font:400 14.5px/1.6 var(--sans,Inter,sans-serif);color:var(--fg,#1a1a19);width:44px;height:44px;padding:0;display:inline-grid;place-items:center;background:none;border:1px solid var(--line,#ebebe7);border-radius:50%;color:var(--muted,#6f6f6a);cursor:pointer;transition:color .2s var(--ease,cubic-bezier(0.25,1,0.5,1)),background .2s var(--ease,cubic-bezier(0.25,1,0.5,1)),border-color .2s var(--ease,cubic-bezier(0.25,1,0.5,1))}.ds-toggle:hover{color:var(--fg,#1a1a19);background:var(--hover,#f3f3f0);border-color:var(--faint,#c9c9c4)}.ds-toggle:focus-visible{outline:1.5px solid var(--accent,#b5552e);outline-offset:3px;border-radius:3px;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{animation:none!important;transition:none!important}}",
      "refersTo": "theme-toggle"
    },
